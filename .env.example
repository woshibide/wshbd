# Copy to .env.deploy.local and set your private deployment destination.
# Keep .env.deploy.local outside Git; SSH uses your existing local authentication.
DEPLOY_HOST=
DEPLOY_PATH=
# Optional private directory outside the public web root:
# DEPLOY_STATE_DIR=
# Previous deployed Git revision for one-time migration; deploy:prepare sets this locally.
# DEPLOY_LEGACY_REVISION=
# Optional alternative ignored inventory file:
# DEPLOY_LEGACY_MANIFEST=
