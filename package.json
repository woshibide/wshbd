{
  "name": "wshbd",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Pyotr Goloub, built as a prerendered static Vue site.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --strictPort",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "media": "node scripts/prepare-media.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"test/e2e/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "p5": "^1.11.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
